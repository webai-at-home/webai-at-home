{
	"name": "@webai/openai-conformance-test",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"openai_conformance_test": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"build:dependencies": "npm run build --workspace @webai/protocol && npm run build --workspace @webai/consumer-cli && npm run build --workspace @webai/openai-api-tool",
		"precore": "npm run build:dependencies",
		"core": "tsx src/cli.ts",
		"pretest": "npm run build:dependencies",
		"test": "npx tsx --test tests/index.test.ts"
	},
	"dependencies": {
		"@webai/openai-api-tool": "0.1.0",
		"chalk": "^5.3.0",
		"commander": "^12.1.0",
		"openai": "^4.77.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.2"
	}
}
