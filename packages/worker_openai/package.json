{
  "name": "@webai/worker-openai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "worker_openai": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:dependencies": "npm run build --workspace @webai/protocol",
    "typecheck": "tsc -p tsconfig.json",
    "predev": "npm run build:dependencies",
    "dev": "tsx src/cli.ts",
    "predev:deployed_gateway": "npm run build:dependencies",
    "dev:deployed_gateway": "npx tsx src/cli.ts --url ws://135.125.8.186:8787",
    "prestart": "npm run build:dependencies",
    "start": "node dist/cli.js",
    "presample:lmstudio": "npm run build:dependencies",
    "sample:lmstudio": "npx tsx src/cli.ts --base-url http://localhost:1234/v1 --model llama-3.2-1b-instruct --worker_name \"worker_openai lmstudio-llama3-2-1b\"",
    "lmstudio:server:start": "lms server start",
    "lmstudio:server:stop": "lms server stop",
    "lmstudio:server:status": "lms server status",
    "test": "npx tsx --test tests/index.test.ts"
  },
  "dependencies": {
    "@webai/protocol": "0.1.0",
    "commander": "^12.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
