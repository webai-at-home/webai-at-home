{
  "name": "@webai/worker-webpage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:dependencies": "npm run build --workspace @webai/protocol",
    "predev": "npm run build:dependencies",
