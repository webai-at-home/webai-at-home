    "pretest": "npm run build:dependencies",
    "test": "npm run typecheck && npx tsx --test tests/index.test.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "@huggingface/transformers": "^4.2.0",
    "@huggingface/transformers-response-constraint": "*",
    "@webai/protocol": "0.1.0",
    "bootstrap": "^5.3.3",
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
