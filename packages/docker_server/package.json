{
  "name": "@webai/docker-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "docker compose -f docker/docker-compose.yml --project-directory ../.. build",
    "start": "docker compose -f docker/docker-compose.yml --project-directory ../.. up -d",
    "stop": "docker compose -f docker/docker-compose.yml --project-directory ../.. down",
    "restart": "docker compose -f docker/docker-compose.yml --project-directory ../.. restart",
    "logs": "docker compose -f docker/docker-compose.yml --project-directory ../.. logs -f",
    "deploy": "git push origin main:production",
    "test": "echo \"packages/docker_server has no automated tests; see README.md for manual verification steps\""
  }
}
