{
	"name": "@webai/consumer-openai",
	"version": "0.1.0",
	"type": "module",
	"bin": {
		"consumer_openai": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"build:dependencies": "npm run build --workspace @webai/protocol",
		"typecheck": "tsc -p tsconfig.json",
		"predev": "npm run build:dependencies",
		"dev": "tsx src/cli.ts server",
		"predev:deployed_gateway": "npm run build:dependencies",
		"dev:deployed_gateway": "npx tsx src/cli.ts server --gateway-url ws://135.125.8.186:8787",
		"prestart": "npm run build:dependencies",
		"start": "node dist/cli.js server",
		"test": "npx tsx --test tests/index.test.ts",
		"test:real:dev_formula": "npx tsx --test tests/real_dev_formula.test.ts",
		"test:real:dev_formula:headed": "REAL_TEST_HEADED=true npx tsx --test tests/real_dev_formula.test.ts",
		"test:real:llm_qwen3_0_6b_sharded": "npx tsx --test tests/real_llm_qwen3_0_6b_sharded.test.ts",
		"test:real:llm_qwen3_0_6b_sharded:headed": "REAL_TEST_HEADED=true npx tsx --test tests/real_llm_qwen3_0_6b_sharded.test.ts",
		"test:real:llm_gemma_nano_chrome_full": "npx tsx --test tests/real_llm_gemma_nano_chrome_full.test.ts",
		"test:real:llm_gemma_nano_chrome_full:headed": "REAL_TEST_HEADED=true npx tsx --test tests/real_llm_gemma_nano_chrome_full.test.ts",
		"test:real:llm_qwen3_5_0_8b_full": "npx tsx --test tests/real_llm_qwen3_5_0_8b_full.test.ts",
		"test:real:llm_qwen3_5_0_8b_full:headed": "REAL_TEST_HEADED=true npx tsx --test tests/real_llm_qwen3_5_0_8b_full.test.ts",
		"test:real:llm_llama3_2_1b_full_native_worker": "npx tsx --test tests/real_llm_llama3_2_1b_full_native_worker.test.ts",
		"test:real:llm_llama3_2_1b_full": "npx tsx --test tests/real_llm_llama3_2_1b_full.test.ts",
		"test:real:llm_llama3_2_1b_full:headed": "REAL_TEST_HEADED=true npx tsx --test tests/real_llm_llama3_2_1b_full.test.ts",
		"example:list_models": "tsx examples/list_models.ts",
		"example:chat_completion_dev_formula": "tsx examples/chat_completion_dev_formula.ts",
		"example:chat_completion_system_message": "tsx examples/chat_completion_system_message.ts",
		"example:chat_completion_nostream_llm_gemma_nano_chrome_full": "tsx examples/chat_completion_nostream_llm_gemma_nano_chrome_full.ts",
		"example:chat_completion_streamed_llm_gemma_nano_chrome_full": "tsx examples/chat_completion_streamed_llm_gemma_nano_chrome_full.ts",
		"example:chat_completion_nostream_llm_qwen3_0_6b_sharded": "tsx examples/chat_completion_nostream_llm_qwen3_0_6b_sharded.ts",
		"example:chat_completion_streamed_llm_qwen3_0_6b_sharded": "tsx examples/chat_completion_streamed_llm_qwen3_0_6b_sharded.ts",
		"example:chat_completion_nostream_llm_qwen3_5_0_8b_full": "tsx examples/chat_completion_nostream_llm_qwen3_5_0_8b_full.ts",
		"example:chat_completion_streamed_llm_qwen3_5_0_8b_full": "tsx examples/chat_completion_streamed_llm_qwen3_5_0_8b_full.ts",
		"example:chat_completion_history_llm_qwen3_5_0_8b_full": "tsx examples/chat_completion_history_llm_qwen3_5_0_8b_full.ts",
		"example:chat_completion_nostream_llm_llama3_2_1b_full": "tsx examples/chat_completion_nostream_llm_llama3_2_1b_full.ts",
		"example:chat_completion_streamed_llm_llama3_2_1b_full": "tsx examples/chat_completion_streamed_llm_llama3_2_1b_full.ts",
		"example:chat_completion_history_llm_llama3_2_1b_full": "tsx examples/chat_completion_history_llm_llama3_2_1b_full.ts"
	},
	"dependencies": {
		"@webai/consumer-cli": "0.1.0",
		"@webai/protocol": "0.1.0",
		"commander": "^12.1.0",
		"express": "^4.21.2",
		"ws": "^8.18.0",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/node": "^22.10.2",
		"@types/ws": "^8.5.13",
		"openai": "^4.77.0",
		"puppeteer": "^25.4.0"
	}
}
