		"example:chat_completion_nostream_llm_llama3_2_1b_full": "tsx examples/chat_completion_nostream_llm_llama3_2_1b_full.ts",
		"example:chat_completion_streamed_llm_llama3_2_1b_full": "tsx examples/chat_completion_streamed_llm_llama3_2_1b_full.ts",
