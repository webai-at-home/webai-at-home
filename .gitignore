node_modules/
dist/
.DS_Store
*.log
.venv/
packages/*/logs/
.claude/worktrees/

# The gateway's durable task state, written at runtime. The file name comes from the
# gateway's --state-file option, which defaults to gateway-state.json in the working
# directory, so the file can appear at the repository root or inside a package.
gateway-state.json
*-state.json

# Raw results of the account key pair experiment, written at runtime by its development server.
packages/_account_key_experiments/verification_documents/
packages/_account_key_experiments/run_reports/

# The gateway's account profiles, written at runtime. The file name comes from the
# gateway's --account-file option, which defaults to gateway-accounts.json in the
# working directory, so the file can appear at the repository root or inside a package.
gateway-accounts.json

# The gateway's append-only accounting ledger, written at runtime. The file name comes
# from the gateway's --ledger-file option, which defaults to gateway-ledger.jsonl in the
# working directory, so the file can appear at the repository root or inside a package.
gateway-ledger.jsonl

# Account key pairs. Each one carries a private key that authenticates as the account it
# belongs to, so none of them may ever be committed, wherever under data/ they are kept.
data/**/*.account_key.json
data/**/*.identity.json

# A packed tarball, and a bundled workspace member's node_modules set aside while packing, left
# behind if packages/webai_at_home_cli's prepack/postpack cycle is interrupted partway through.
*.tgz
node_modules.webai_at_home_cli_pack_backup/
